{
  "name": "managed-vault-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "abi": "node scripts/export-abi.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json",
    "format:check": "prettier --check src scripts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "8.3.2"
  }
}
